{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile C++",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-o",
                "starmap3",
                "./src/Main.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "group": "build"
        },
        {
            "label": "Copy Resources (Windows)",
            "type": "shell",
            "command": "Copy-Item",
            "args": [
                "-Path",
                "${workspaceFolder}\\content\\*",
                "-Destination",
                "${workspaceFolder}\\build\\bin\\",
                "-Recurse",
                "-Force"
            ],
            "options": {
                "shell": {
                    "executable": "powershell.exe"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Copy Resources (Linux/macOS)",
            "type": "shell",
            "command": "cp",
            "args": [
                "-r",
                "${workspaceFolder}/content/*",
                "${workspaceFolder}/build/bin/"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/bash"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build And Copy Resources (Windows)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Build",
                "Copy Resources (Windows)"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "CMake Build And Copy Resources (Linux/macOS)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Build",
                "Copy Resources (Linux/macOS)"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
